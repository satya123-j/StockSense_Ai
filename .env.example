# ==========================================
# StockSense AI - Environment Configuration
# ==========================================

# Flask Environment
FLASK_APP=run.py
FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=stocksense_ai_dev_secret_key_change_in_production_2026

# JWT Security
JWT_SECRET_KEY=stocksense_jwt_secure_secret_key_2026
JWT_ACCESS_TOKEN_EXPIRES_DAYS=7

# Upstox Developer API v2 Configuration
# Get credentials from: https://upstox.com/developer/api-documentation/
UPSTOX_CLIENT_ID=your_upstox_api_key_here
UPSTOX_CLIENT_SECRET=your_upstox_api_secret_here
UPSTOX_ACCESS_TOKEN=your_upstox_access_token_here
UPSTOX_REDIRECT_URI=http://127.0.0.1:5000/api/auth/upstox/callback
UPSTOX_BASE_URL=https://api.upstox.com/v2
UPSTOX_ENABLED=True

# Database Configuration (MySQL)
# Example: mysql+pymysql://username:password@localhost:3306/stocksense_ai
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=rootpassword
MYSQL_DB=stocksense_ai

# Fallback SQLite DB (used if USE_SQLITE=True or MySQL is unreachable)
USE_SQLITE=True
DATABASE_URL=sqlite:///stocksense.db

# Market Data Cache & Fallback Settings
CACHE_EXPIRY_SECONDS=180
ENABLE_DEMO_DATA_FALLBACK=True

# AI Chatbot Configuration
# External LLM API keys are optional. If not set, the chatbot runs using its built-in
# quantitative domain analysis engine without requiring any external API calls.
# Set CHATBOT_PROVIDER to: auto, gemini, openai, or domain_engine
CHATBOT_PROVIDER=auto
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

